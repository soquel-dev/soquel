---
import ApprovalCard from '@/components/ApprovalCard.astro'
import Downloads from '@/components/Downloads.astro'
import Shot from '@/components/Shot.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import SiteHeader from '@/components/SiteHeader.astro'
import Base from '@/layouts/Base.astro'
import { ENGINES, FEATURES, HERO_SHOT, PRICE, SHOTS } from '@/lib/site'

/// The frames only stand in during development, so the gap they leave has to go too.
const shotsShown = SHOTS.some(shot => shot.src) || import.meta.env.MODE !== 'production'

const guardrails = [
  {
    claim: 'Read-only is the engine\'s job, not a SQL parser\'s.',
    proof:
      'Agent reads run inside a READ ONLY transaction on Postgres and MySQL, or on a handle opened read-only at the filesystem level on SQLite. A statement that slips past classification still cannot write.',
  },
  {
    claim: 'Off, and empty, by default.',
    proof:
      'The server starts stopped, and every connection stays invisible to agents until you opt it in. Read-only or writes-need-approval, one connection at a time.',
  },
  {
    claim: 'Every call is logged.',
    proof: 'Tool, connection, statement, outcome and duration, readable from the app.',
  },
  {
    claim: 'Local only.',
    proof:
      'The server binds loopback and requires a bearer token that never leaves your machine. Results are capped and paginated, and agent queries carry a 30 second engine-enforced timeout.',
  },
]


---

<Base>
  <div class="mx-auto max-w-3xl px-6">
    <SiteHeader />

    <main>
      <section class="py-16 sm:py-24">
        <h1
          class="settle font-mono text-[2rem] leading-[1.1] font-semibold tracking-[-0.03em] text-balance sm:text-5xl"
          style="--step: 0"
        >
          Lend an agent the query.<br />Never the credentials.
        </h1>

        <p class="settle mt-6 max-w-xl text-lg leading-relaxed text-mute" style="--step: 1">
          Soquel is a desktop database client for Postgres, MySQL, SQLite, Redis and MongoDB. It can
          also hand a coding agent a way in, one connection at a time, while the passwords stay in
          the Rust core and the OS keychain.
        </p>

        <div class="mt-12">
          {
            HERO_SHOT.src
              ? <Shot src={HERO_SHOT.src} alt={HERO_SHOT.alt} spec={HERO_SHOT.spec} />
              : <ApprovalCard />
          }
        </div>
      </section>

      <section class="border-t border-rule py-14">
        <p class="label">Agent access</p>
        <h2 class="mt-3 max-w-xl font-mono text-xl leading-snug font-medium tracking-tight">
          An agent gets the tools, not a copy of your database password.
        </h2>
        <p class="mt-4 max-w-xl text-mute">
          Soquel runs a local MCP server. Point your agent at the app instead of pasting a
          connection string into its config, and the guardrails come with it.
        </p>

        <div class="mt-10 space-y-px">
          {
            guardrails.map(item => (
              <div class="border-t border-rule py-6 sm:grid sm:grid-cols-[16rem_1fr] sm:gap-8">
                <h3 class="font-mono text-sm leading-relaxed font-medium">{item.claim}</h3>
                <p class="mt-2 text-sm leading-relaxed text-mute sm:mt-0">{item.proof}</p>
              </div>
            ))
          }
        </div>

        <p class="mt-8 text-sm text-mute">
          Any client that speaks MCP over streamable HTTP works, with the same URL and token.
          Claude Code takes it as one line:
        </p>
        <pre
          class="mt-3 overflow-x-auto rounded-card border border-rule bg-wash px-4 py-3 font-mono text-xs leading-6"
        >claude mcp add --transport http soquel http://127.0.0.1:52700/mcp \
  --header <span class="text-string">"Authorization: Bearer &lt;token&gt;"</span></pre>
      </section>

      <section class="border-t border-rule py-14">
        <p class="label">The client</p>
        <h2 class="mt-3 max-w-xl font-mono text-xl leading-snug font-medium tracking-tight">
          It has to be a good client first.
        </h2>
        <ul class="mt-8 space-y-3">
          {
            FEATURES.map(line => (
              <li class="flex gap-3 text-sm leading-relaxed">
                <span aria-hidden="true" class="mt-2.5 h-px w-4 shrink-0 bg-rule" />
                <span>{line}</span>
              </li>
            ))
          }
        </ul>

        {
          shotsShown && (
            <div class="mt-12 space-y-10">
              {SHOTS.map(shot => <Shot {...shot} />)}
            </div>
          )
        }
      </section>

      <section class="border-t border-rule py-14">
        <p class="label">Engines</p>
        <dl class="mt-6">
          {
            ENGINES.map(engine => (
              <div class="flex items-baseline justify-between gap-6 border-b border-rule py-3">
                <dt class="font-mono text-sm font-medium">{engine.name}</dt>
                <dd class="text-right text-sm text-mute">{engine.note}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="border-t border-rule py-14">
        <p class="label">Pricing</p>
        <h2 class="mt-3 max-w-xl font-mono text-xl leading-snug font-medium tracking-tight">
          Free while you judge it. {PRICE.licence} once when it earns it.
        </h2>
        <p class="mt-4 max-w-xl text-mute">
          The free tier holds back one thing, how many workspace tabs you can open: {PRICE.freeTabs}
          per connection. Every engine, the SQL editor, tunnels and agent access all work without a
          licence. A licence lifts that limit for good and includes {PRICE.months} months of updates,
          with no subscription and nothing to cancel.
        </p>
        <p class="mt-6">
          <a
            href="/pricing"
            data-umami-event="pricing-index"
            class="font-mono text-sm text-ink underline underline-offset-4"
          >What a year of updates means</a
          >
        </p>
      </section>

      <Downloads />
    </main>

    <SiteFooter />
  </div>
</Base>
