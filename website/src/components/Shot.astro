---
interface Props {
  src?: string | null
  alt: string
  caption?: string
  spec: string
}

const { src, alt, caption, spec } = Astro.props

// The frame waiting for a capture is a working note, not content: it carries the
// spec so the shot gets taken right, and it never reaches a deployed page.
const showSpec = !src && import.meta.env.MODE !== 'production'
---

{
  (src || showSpec) && (
    <figure class="m-0">
      {src
        ? (
            <img
              src={src}
              alt={alt}
              width="1440"
              height="900"
              loading="lazy"
              decoding="async"
              class="rounded-card border-rule w-full border"
            />
          )
        : (
            <div class="rounded-card border-rule flex aspect-[16/10] w-full flex-col items-center justify-center gap-2 border border-dashed px-6 text-center">
              <p class="label">Placeholder</p>
              <p class="text-mute font-mono text-xs">{spec}</p>
            </div>
          )}
      {caption && <figcaption class="text-mute mt-3 text-sm">{caption}</figcaption>}
    </figure>
  )
}
